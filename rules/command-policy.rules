# Personal command policy examples.
#
# Keep this file conservative. Specific safe commands can be added as they become routine.

prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["npm", "run", "build"], decision="allow")
prefix_rule(pattern=["npm", "test"], decision="allow")
prefix_rule(pattern=["uv", "run", "pytest"], decision="allow")
prefix_rule(pattern=["uv", "run", "ruff", "check"], decision="allow")
prefix_rule(pattern=["uv", "run", "mypy"], decision="allow")
prefix_rule(pattern=["git", "clean", "-n"], decision="allow")
prefix_rule(pattern=["git", "clean", "--dry-run"], decision="allow")
prefix_rule(pattern=["git", "restore", "--staged"], decision="allow")

prefix_rule(
    pattern=["git", "push"],
    decision="prompt",
    justification="Pushing changes remote repository state and requires explicit user confirmation."
)
prefix_rule(
    pattern=["git", "reset", "--hard"],
    decision="prompt",
    justification="Hard reset discards local work and requires explicit user confirmation."
)
prefix_rule(
    pattern=["git", "clean"],
    decision="prompt",
    justification="Cleaning can remove untracked files and requires explicit user confirmation."
)
prefix_rule(
    pattern=["git", "checkout", "--"],
    decision="prompt",
    justification="Checking out paths can discard file edits and requires explicit user confirmation."
)
prefix_rule(
    pattern=["git", "restore"],
    decision="prompt",
    justification="Restoring files can discard edits and requires explicit user confirmation."
)
prefix_rule(
    pattern=["rm", "-rf"],
    decision="prompt",
    justification="Recursive deletion requires explicit user confirmation."
)
prefix_rule(
    pattern=["Remove-Item"],
    decision="prompt",
    justification="PowerShell deletion can remove local files and requires explicit user confirmation."
)
prefix_rule(
    pattern=["rm"],
    decision="prompt",
    justification="PowerShell deletion aliases can remove local files and require explicit user confirmation."
)
prefix_rule(
    pattern=["del"],
    decision="prompt",
    justification="Windows deletion commands can remove local files and require explicit user confirmation."
)
prefix_rule(
    pattern=["erase"],
    decision="prompt",
    justification="Windows deletion commands can remove local files and require explicit user confirmation."
)
prefix_rule(
    pattern=["rmdir"],
    decision="prompt",
    justification="Windows directory deletion can remove local files and requires explicit user confirmation."
)
prefix_rule(
    pattern=["rd"],
    decision="prompt",
    justification="Windows directory deletion can remove local files and requires explicit user confirmation."
)
prefix_rule(
    pattern=["cmd", "/c", "del"],
    decision="prompt",
    justification="cmd deletion commands can remove local files and require explicit user confirmation."
)
prefix_rule(
    pattern=["cmd", "/c", "rmdir"],
    decision="prompt",
    justification="cmd directory deletion can remove local files and requires explicit user confirmation."
)
prefix_rule(
    pattern=["gh", "release"],
    decision="prompt",
    justification="Release operations mutate remote project state and require explicit user confirmation."
)
prefix_rule(
    pattern=["npm", "publish"],
    decision="prompt",
    justification="Publishing changes external package state and requires explicit user confirmation."
)

prefix_rule(
    pattern=["gh", "pr", "create"],
    decision="prompt",
    justification="Creating a pull request changes remote project state."
)
prefix_rule(
    pattern=["gh", "pr", "merge"],
    decision="prompt",
    justification="Merging a pull request changes remote project state."
)
prefix_rule(
    pattern=["npm", "install"],
    decision="prompt",
    justification="Installing packages may change lockfiles and download dependencies."
)
prefix_rule(
    pattern=["pip", "install"],
    decision="prompt",
    justification="Installing packages changes the local environment and downloads dependencies."
)
prefix_rule(
    pattern=["python", "-m", "pip", "install"],
    decision="prompt",
    justification="Installing packages changes the local environment and downloads dependencies."
)
prefix_rule(
    pattern=["uv", "sync"],
    decision="prompt",
    justification="Syncing environments may download dependencies and change local state."
)
prefix_rule(
    pattern=["uv", "add"],
    decision="prompt",
    justification="Adding dependencies changes project metadata and may download packages."
)
prefix_rule(
    pattern=["winget", "install"],
    decision="prompt",
    justification="Installing system packages changes the machine environment."
)
prefix_rule(
    pattern=["gcloud"],
    decision="prompt",
    justification="Google Cloud commands can read or mutate cloud resources and may incur cost."
)
prefix_rule(
    pattern=["gsutil"],
    decision="prompt",
    justification="Google Cloud Storage commands can read or mutate cloud resources and may incur cost."
)
prefix_rule(
    pattern=["docker", "compose", "up"],
    decision="prompt",
    justification="Starting services can create long-running local state."
)
prefix_rule(
    pattern=["alembic", "upgrade"],
    decision="prompt",
    justification="Database migrations require explicit user control."
)
prefix_rule(
    pattern=["alembic", "downgrade"],
    decision="prompt",
    justification="Database migrations require explicit user control."
)
