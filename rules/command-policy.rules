# Personal command policy examples.
#
# Keep this file conservative. Specific safe commands can be added as they become routine.
# Add allow rules only for read-only commands. Repository-controlled build and test commands can
# execute arbitrary code, so the user layer keeps them behind a review decision. The shared config
# routes eligible prompt decisions to the automatic approvals reviewer; prompt must not be replaced
# with allow merely to avoid a manual approval dialog.
# A trusted repository may add narrower project-local allow rules after its config layer is trusted.
# Package install, networked tools, publishing, deployment, migration, remote mutation, cost
# incurring cloud operations, and destructive commands must remain prompt or forbidden.

prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(
    pattern=["npm", "run"],
    decision="prompt",
    justification="Repository-controlled npm scripts can execute arbitrary code; confirm repository trust first.",
    match=["npm run build", "npm run lint", "npm run typecheck"],
    not_match=["npm test"],
)
prefix_rule(
    pattern=["npm", "test"],
    decision="prompt",
    justification="Repository-controlled test scripts can execute arbitrary code; confirm repository trust first.",
    match=["npm test", "npm test -- --watch=false"],
    not_match=["npm run build"],
)
prefix_rule(
    pattern=["uv", "run"],
    decision="prompt",
    justification="Repository-controlled uv commands, tools, and plugins can execute arbitrary code; confirm repository trust first.",
    match=["uv run pytest", "uv run ruff check .", "uv run mypy src"],
    not_match=["uv sync"],
)

# Broad read-looking commands can still execute configured preprocessors or external diff drivers.
prefix_rule(
    pattern=["rg"],
    decision="prompt",
    justification="ripgrep --pre can execute an arbitrary preprocessor; confirm repository trust before running rg from the user layer.",
    match=["rg workflow", "rg --pre pwsh workflow"],
)
prefix_rule(
    pattern=["git", "diff"],
    decision="prompt",
    justification="git diff can execute configured textconv or external diff drivers; confirm repository trust first.",
    match=["git diff", "git diff --ext-diff"],
    not_match=["git status"],
)
prefix_rule(
    pattern=["git", "log"],
    decision="prompt",
    justification="git log accepts patch and external diff options that can invoke configured drivers; confirm repository trust first."
)
prefix_rule(
    pattern=["git", "show"],
    decision="prompt",
    justification="git show can invoke configured textconv or external diff drivers; confirm repository trust first."
)

# Common project runners are prompt-gated at the user layer. This list is intentionally not an
# exhaustive trust model: commands without a matching rule retain the runtime/sandbox default.
prefix_rule(pattern=["npm", "exec"], decision="prompt", justification="npm exec can run repository or downloaded code.")
prefix_rule(pattern=["npx"], decision="prompt", justification="npx can run repository or downloaded code.")
prefix_rule(pattern=["pnpm"], decision="prompt", justification="pnpm commands can run repository scripts or mutate dependencies.")
prefix_rule(pattern=["yarn"], decision="prompt", justification="Yarn commands can run repository scripts or mutate dependencies.")
prefix_rule(pattern=["bun"], decision="prompt", justification="Bun commands can run repository scripts or downloaded code.")
prefix_rule(pattern=["deno"], decision="prompt", justification="Deno commands can execute project code and access configured capabilities.")
prefix_rule(pattern=["uvx"], decision="prompt", justification="uvx can download and execute tools.")
prefix_rule(pattern=["make"], decision="prompt", justification="Make targets are repository-controlled arbitrary commands.")
prefix_rule(pattern=["cargo"], decision="prompt", justification="Cargo commands can execute builds, tests, plugins, and build scripts.")
prefix_rule(pattern=["go"], decision="prompt", justification="Go project commands can execute tests, generators, and toolchain hooks.")
prefix_rule(pattern=["dotnet"], decision="prompt", justification="dotnet project commands can execute builds, tests, and tools.")
prefix_rule(pattern=["mvn"], decision="prompt", justification="Maven goals and plugins can execute repository-controlled code.")
prefix_rule(pattern=["gradle"], decision="prompt", justification="Gradle builds and plugins can execute repository-controlled code.")
prefix_rule(pattern=["gradlew"], decision="prompt", justification="The repository Gradle wrapper executes repository-controlled build logic.")
prefix_rule(pattern=["./gradlew"], decision="prompt", justification="The repository Gradle wrapper executes repository-controlled build logic.")

prefix_rule(
    pattern=["git", "push"],
    decision="prompt",
    justification="Pushing changes remote repository state and requires explicit user confirmation."
)
prefix_rule(
    pattern=["git", "reset", "--hard"],
    decision="prompt",
    justification="Hard reset discards local work and requires explicit user confirmation."
)
prefix_rule(
    pattern=["git", "clean"],
    decision="prompt",
    justification="Cleaning can remove untracked files and requires explicit user confirmation."
)
prefix_rule(
    pattern=["git", "checkout", "--"],
    decision="prompt",
    justification="Checking out paths can discard file edits and requires explicit user confirmation."
)
prefix_rule(
    pattern=["git", "restore"],
    decision="prompt",
    justification="Restoring files can discard edits and requires explicit user confirmation."
)
prefix_rule(
    pattern=["rm", "-rf"],
    decision="prompt",
    justification="Recursive deletion requires explicit user confirmation."
)
prefix_rule(
    pattern=["Remove-Item"],
    decision="prompt",
    justification="PowerShell deletion can remove local files and requires explicit user confirmation."
)
prefix_rule(
    pattern=["rm"],
    decision="prompt",
    justification="PowerShell deletion aliases can remove local files and require explicit user confirmation."
)
prefix_rule(
    pattern=["del"],
    decision="prompt",
    justification="Windows deletion commands can remove local files and require explicit user confirmation."
)
prefix_rule(
    pattern=["erase"],
    decision="prompt",
    justification="Windows deletion commands can remove local files and require explicit user confirmation."
)
prefix_rule(
    pattern=["rmdir"],
    decision="prompt",
    justification="Windows directory deletion can remove local files and requires explicit user confirmation."
)
prefix_rule(
    pattern=["rd"],
    decision="prompt",
    justification="Windows directory deletion can remove local files and requires explicit user confirmation."
)
prefix_rule(
    pattern=["cmd", "/c", "del"],
    decision="prompt",
    justification="cmd deletion commands can remove local files and require explicit user confirmation."
)
prefix_rule(
    pattern=["cmd", "/c", "rmdir"],
    decision="prompt",
    justification="cmd directory deletion can remove local files and requires explicit user confirmation."
)
prefix_rule(
    pattern=["gh", "release"],
    decision="prompt",
    justification="Release operations mutate remote project state and require explicit user confirmation."
)
prefix_rule(
    pattern=["npm", "publish"],
    decision="prompt",
    justification="Publishing changes external package state and requires explicit user confirmation."
)

prefix_rule(
    pattern=["gh", "pr", "create"],
    decision="prompt",
    justification="Creating a pull request changes remote project state."
)
prefix_rule(
    pattern=["gh", "pr", "merge"],
    decision="prompt",
    justification="Merging a pull request changes remote project state."
)
prefix_rule(
    pattern=["npm", "install"],
    decision="prompt",
    justification="Installing packages may change lockfiles and download dependencies."
)
prefix_rule(
    pattern=["pip", "install"],
    decision="prompt",
    justification="Installing packages changes the local environment and downloads dependencies."
)
prefix_rule(
    pattern=["python", "-m", "pip", "install"],
    decision="prompt",
    justification="Installing packages changes the local environment and downloads dependencies."
)
prefix_rule(
    pattern=["uv", "sync"],
    decision="prompt",
    justification="Syncing environments may download dependencies and change local state."
)
prefix_rule(
    pattern=["uv", "add"],
    decision="prompt",
    justification="Adding dependencies changes project metadata and may download packages."
)
prefix_rule(
    pattern=["winget", "install"],
    decision="prompt",
    justification="Installing system packages changes the machine environment."
)
prefix_rule(
    pattern=["gcloud"],
    decision="prompt",
    justification="Google Cloud commands can read or mutate cloud resources and may incur cost."
)
prefix_rule(
    pattern=["gsutil"],
    decision="prompt",
    justification="Google Cloud Storage commands can read or mutate cloud resources and may incur cost."
)

# Cloud and infrastructure tools often have both read-only commands and remote mutations.
# Keep broad provider CLIs and plan commands behind prompt until account, workspace, region,
# context, and target environment are known. Apply/deploy/destroy/delete commands always need
# explicit confirmation because they can mutate remote resources, incur cost, or delete data.
prefix_rule(
    pattern=["aws"],
    decision="prompt",
    justification="AWS CLI commands can read or mutate cloud resources and may incur cost."
)
prefix_rule(
    pattern=["terraform", "plan"],
    decision="prompt",
    justification="Terraform plan can read remote state and providers; confirm workspace, backend, and target environment first."
)
prefix_rule(
    pattern=["terraform", "apply"],
    decision="prompt",
    justification="Terraform apply mutates infrastructure and requires explicit approval."
)
prefix_rule(
    pattern=["terraform", "destroy"],
    decision="prompt",
    justification="Terraform destroy removes infrastructure and requires explicit approval."
)
prefix_rule(
    pattern=["kubectl", "apply"],
    decision="prompt",
    justification="Kubernetes apply mutates cluster resources and requires explicit approval."
)
prefix_rule(
    pattern=["kubectl", "delete"],
    decision="prompt",
    justification="Kubernetes delete removes cluster resources and requires explicit approval."
)
prefix_rule(
    pattern=["helm", "upgrade"],
    decision="prompt",
    justification="Helm upgrade mutates cluster releases and requires explicit approval."
)
prefix_rule(
    pattern=["helm", "uninstall"],
    decision="prompt",
    justification="Helm uninstall removes cluster releases and requires explicit approval."
)
prefix_rule(
    pattern=["cdk", "deploy"],
    decision="prompt",
    justification="CDK deploy mutates cloud infrastructure and may incur cost."
)
prefix_rule(
    pattern=["cdk", "destroy"],
    decision="prompt",
    justification="CDK destroy removes cloud infrastructure and requires explicit approval."
)
prefix_rule(
    pattern=["sam", "deploy"],
    decision="prompt",
    justification="SAM deploy mutates cloud infrastructure and may incur cost."
)
prefix_rule(
    pattern=["serverless", "deploy"],
    decision="prompt",
    justification="Serverless deploy mutates cloud infrastructure and may incur cost."
)
prefix_rule(
    pattern=["pulumi", "up"],
    decision="prompt",
    justification="Pulumi up mutates infrastructure and requires explicit approval."
)
prefix_rule(
    pattern=["pulumi", "destroy"],
    decision="prompt",
    justification="Pulumi destroy removes infrastructure and requires explicit approval."
)
prefix_rule(
    pattern=["psql"],
    decision="prompt",
    justification="Database client commands can read or mutate remote data and require target confirmation."
)
prefix_rule(
    pattern=["mysql"],
    decision="prompt",
    justification="Database client commands can read or mutate remote data and require target confirmation."
)
prefix_rule(
    pattern=["influx"],
    decision="prompt",
    justification="Database client commands can read or mutate remote data and require target confirmation."
)
prefix_rule(
    pattern=["docker", "compose", "up"],
    decision="prompt",
    justification="Starting services can create long-running local state."
)
prefix_rule(
    pattern=["docker", "compose", "down", "-v"],
    decision="prompt",
    justification="Docker compose down -v removes volumes and can delete local service data."
)
prefix_rule(
    pattern=["docker", "system", "prune"],
    decision="prompt",
    justification="Docker system prune deletes local Docker resources and requires explicit approval."
)
prefix_rule(
    pattern=["docker", "volume", "prune"],
    decision="prompt",
    justification="Docker volume prune deletes local volumes and can remove persistent service data."
)
prefix_rule(
    pattern=["alembic", "upgrade"],
    decision="prompt",
    justification="Database migrations require explicit user control."
)
prefix_rule(
    pattern=["alembic", "downgrade"],
    decision="prompt",
    justification="Database migrations require explicit user control."
)
